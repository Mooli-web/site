# ============================================================================ #
#  نمونه فایل تنظیمات محیطی «کلینیک زیبایی»
#  این فایل را به .env کپی کنید و مقادیر را متناسب با محیط خود تغییر دهید:
#      cp .env.example .env
# ============================================================================ #

# ---- Django ----
# برای تولید کلید امن:  python manage.py generate_secret_key
SECRET_KEY=change-me-in-production-please

# در production حتماً False باشد
DEBUG=False

# دامنه‌های مجاز (با کاما جدا شوند)
ALLOWED_HOSTS=clinic.example.com,www.clinic.example.com

# دامنه‌های مورد اعتماد برای CSRF (با https). در production الزامی است.
CSRF_TRUSTED_ORIGINS=https://clinic.example.com,https://www.clinic.example.com

# ---- Database (PostgreSQL) ----
DB_NAME=beauty_clinic
DB_USER=beauty_clinic
DB_PASSWORD=strong-db-password-here
DB_HOST=127.0.0.1
DB_PORT=5432

# True فقط برای توسعه‌ی سریع محلی (بدون نیاز به Postgres). در production False.
USE_SQLITE=False

# ---- Localization ----
TIME_ZONE=Asia/Tehran

# ---- Security (production؛ این‌ها فقط وقتی DEBUG=False اعمال می‌شوند) ----
# هدایت اجباری به HTTPS (پشت nginx با TLS). اگر TLS را nginx هندل می‌کند True بماند.
SECURE_SSL_REDIRECT=True
# مدت HSTS بر حسب ثانیه (۱ سال). برای شروع می‌توانید مقدار کوچک‌تری بگذارید.
SECURE_HSTS_SECONDS=31536000

# ---- Logging ----
DJANGO_LOG_LEVEL=INFO

# ---- ZarinPal ----
# در حالت Sandbox هر مرچنت‌آیدی معتبری (UUID) قابل استفاده است.
# برای محیط واقعی، مرچنت‌آیدی پنل زرین‌پال خود را قرار دهید و ZARINPAL_SANDBOX=False کنید.
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=False
