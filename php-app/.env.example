# این فایل را به نام .env کپی کنید و مقادیر را پر کنید
APP_URL=https://example.com
DEBUG=false

# مسیر فایل پایگاه داده SQLite (پیش‌فرض: storage/db/clinic.sqlite)
# DB_PATH=/home/USER/clinic-data/clinic.sqlite

# زرین‌پال — مرچنت ۳۶ کاراکتری. برای تست sandbox=true
ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ZARINPAL_SANDBOX=true

# اگر سایت داخل iframe سایت دیگری نمایش داده می‌شود (معمولاً لازم نیست): COOKIE_SAMESITE=None
